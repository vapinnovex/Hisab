APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=hisab
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
# Email verification for owner registration, recovery and mobile changes.
# Development displays the code in the app; production requires Brevo.
EMAIL_PROVIDER=dev
BREVO_API_KEY=
BREVO_SENDER_NAME=Hisab
BREVO_SENDER_EMAIL=
DEV_OTP=123456
OTP_EXPIRE_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Exact browser origins; production uses your stable HTTPS PWA domain.
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:8083"]
