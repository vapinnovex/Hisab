# BACKEND ONLY: FastAPI / Render. Never put these secrets in mobile/.env.
# This file is a template; pushing it does NOT update Render environment variables.
# For https://hishob-dev.onrender.com, set APP_ENV=development in Render.
# Keep your EXISTING DEV MONGODB_URI, MONGODB_DATABASE, JWT_SECRET, email settings
# and FACE_ENCRYPTION_KEY. The local database/secret values below are placeholders
# for local development, NOT replacements for your working Render settings.
# Restart/redeploy the backend after changing its environment.

APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=hisab
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
# Email verification for owner registration, recovery and mobile changes.
# Development displays the code in the app; production requires Brevo.
EMAIL_PROVIDER=dev
BREVO_API_KEY=
BREVO_SENDER_NAME=Hisab
BREVO_SENDER_EMAIL=
DEV_OTP=123456
OTP_EXPIRE_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Browser origins must match the FRONTEND domain, not the Render backend URL.
# Render DEV (stable frontend configured in this repository):
# CORS_ORIGINS=["https://hisab-mobile-delta.vercel.app"]
# Keep any other explicitly authorized DEV origins if you already use them.
# Local development defaults:
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:8083"]
# Face attendance: required in production only when enabling face attendance.
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key backed up separately. Changing it without migration makes templates unreadable.
FACE_ENCRYPTION_KEY=
# Optional override; default is backend/models (or /app/models in Docker).
FACE_MODELS_DIR=
# Conservative pilot defaults; calibrate on representative shop/device conditions.
FACE_MATCH_THRESHOLD=0.50
FACE_MATCH_MARGIN=0.08
# ---------------------------------------------------------------------------
# RADIOSOFT REAL DEV PILOT — separate from the synthetic demo
# ---------------------------------------------------------------------------
# Deploy code now with these defaults if source IDs/dates are not yet confirmed.
# The app continues working; real setup/ingestion stays disabled.
RADIOSOFT_REAL_ENABLED=false
RADIOSOFT_REAL_PILOTS=[]

# To make owner setup available on DEV:
# 1. Replace ALL five placeholders in the single-line JSON below.
# 2. In Render, replace RADIOSOFT_REAL_PILOTS with that JSON array.
# 3. Set RADIOSOFT_REAL_ENABLED=true and redeploy.
# 4. Owner opens Account -> RadioSoft real DEV preview, confirms the displayed
#    scope and tracking date, then pairs the separately qualified Windows service.
# Enabling this flag alone does not install/start the PC connector or post money.
# APP_ENV must remain development; production rejects this feature.
#
# RADIOSOFT_REAL_PILOTS=[{"shop_id":"14559e70-f9b0-40fd-8bfe-34aea0745f43","owner_id":"ef2f1849-4f09-4807-9d46-551b1463dcdf","source_id":"<approved-PC-installation-id>","generation":"<approved-RsDB-generation-id>","database":"RsDB","firm_codes":[0],"invoice_types":[0,1],"tracking_from":"<owner-approved-YYYY-MM-DD>","capture_from":"<approved-YYYY-MM-DD>","capture_until":"<approved-exclusive-YYYY-MM-DD>","mapping_version":"real-display-v1"}]
#
# Fields:
# shop_id / owner_id: confirmed DEV IDs above. Setup verifies ownership in DEV.
# source_id: stable identifier assigned to this qualified shop-PC installation.
# generation: stable identifier assigned to this RsDB database generation.
#   These are NOT passwords. Record them in the local binding.json too.
#   Never change either ID to fix retries, reinstall, or restore a database.
# database: RsDB (the supported local source database).
# firm_codes / invoice_types: [0] and [0,1] are PROPOSED; owner confirms in setup.
# tracking_from: agreed tracking start date; earlier imports are historical review.
# capture_from: earliest bill date the connector may read, inclusive.
# capture_until: end of approved capture window, EXCLUSIVE.
#   Dates must satisfy capture_from <= tracking_from < capture_until.
#   Use real YYYY-MM-DD dates; do not paste the placeholder JSON into Render.
#   Choose an approved end date that covers the pilot period. Scope is locked
#   after setup; changing dates/IDs later requires the documented recovery process.
# mapping_version: keep real-display-v1.
# All real pilot bills remain DISPLAY/REVIEW ONLY, even after tracking_from.
# No refund, receipt, collectible debt, store credit or accounting is auto-created.
# Enter JSON arrays as ONE LINE in Render's value field, without outer shell quotes.
# Do not place SQL passwords, pairing codes or connector credentials in these vars.
# Full setup/build/stop instructions: ../docs/SHOP-PC-DEV-SETUP.md

# Separate synthetic demo. Leave disabled for a real-only DEV pilot.
# If already using an approved synthetic pilot, retain its existing settings;
# enabling the real pilot does not require changing the synthetic configuration.
RADIOSOFT_SYNTHETIC_ENABLED=false
RADIOSOFT_PILOTS=[]
# Synthetic-only example (never put real records into this contract):
# RADIOSOFT_PILOTS=[{"shop_id":"SYNTHETIC_SHOP_ID","owner_id":"SYNTHETIC_OWNER_ID","source_id":"synthetic-installation","firm_codes":[0],"tracking_from":"2026-11-01"}]
