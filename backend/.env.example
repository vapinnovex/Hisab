APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=hisab
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
# Email verification for owner registration, recovery and mobile changes.
# Development displays the code in the app; production requires Brevo.
EMAIL_PROVIDER=dev
BREVO_API_KEY=
BREVO_SENDER_NAME=Hisab
BREVO_SENDER_EMAIL=
DEV_OTP=123456
OTP_EXPIRE_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Exact browser origins; production uses your stable HTTPS PWA domain.
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:8083"]
# Face attendance: required in production only when enabling face attendance.
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key backed up separately. Changing it without migration makes templates unreadable.
FACE_ENCRYPTION_KEY=
# Optional override; default is backend/models (or /app/models in Docker).
FACE_MODELS_DIR=
# Conservative pilot defaults; calibrate on representative shop/device conditions.
FACE_MATCH_THRESHOLD=0.50
FACE_MATCH_MARGIN=0.08
# RadioSoft foundation: OFF everywhere, synthetic development/test data only.
RADIOSOFT_SYNTHETIC_ENABLED=false
RADIOSOFT_PILOTS=[]
# Isolated test/development example (replace every placeholder with synthetic IDs):
# RADIOSOFT_PILOTS=[{"shop_id":"SYNTHETIC_SHOP_ID","owner_id":"SYNTHETIC_OWNER_ID","source_id":"synthetic-installation","firm_codes":[0],"tracking_from":"2026-11-01"}]
# APP_ENV=production refuses RADIOSOFT_SYNTHETIC_ENABLED=true. No ACCOUNTING mode exists.
