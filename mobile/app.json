{
  "expo": {
    "name": "Hishob",
    "slug": "hishob",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/hishob-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisab.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F2",
        "foregroundImage": "./assets/brand/hishob-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hisab.app"
    },
    "web": {
      "favicon": "./assets/brand/hishob-logo.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/hishob-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F2"
        }
      ]
    ],
    "scheme": "hishob"
  }
}
