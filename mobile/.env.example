# FRONTEND DEV TEMPLATE — mobile Expo / Vercel, not the backend.
# Pushing this file does NOT set dashboard environment variables.
# For the DEV Vercel project hisab-mobile (branch dev), set the next THREE values
# in that project's Production scope. "Production" here means its stable hosted
# deployment; Hishob's application environment is still development.
# Redeploy after changing them. Keep the separate production project unchanged.
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development
API_PROXY_TARGET=https://hishob-dev.onrender.com

# No trailing slash or /api suffix on API_PROXY_TARGET.
# Vercel provides VERCEL_PROJECT_NAME and VERCEL_GIT_COMMIT_REF automatically;
# enable access to system environment variables, never enter fake values manually.
# Do not manually set NODE_ENV to select the DEV backend.

# Native builds and local Expo use this URL. Exported web uses the same-origin
# /api proxy configured by API_PROXY_TARGET, so this is optional on Vercel.
EXPO_PUBLIC_API_URL=https://hishob-dev.onrender.com

# REMOVE EXPO_PUBLIC_WEB_API_URL from the hosted Vercel environment.
# A nonempty value is rejected by the deployment guard.
# For local Expo ONLY, you may uncomment and use a local backend instead:
# EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_WEB_API_URL=http://localhost:8000
# Physical phone: use your computer's LAN IP, e.g. http://192.168.1.20:8000.
# Android emulator: http://10.0.2.2:8000. iOS simulator: http://localhost:8000.

# RadioSoft flags/owner/shop scope belong ONLY in backend/.env.example / Render.
# Never add MongoDB credentials, JWT secrets, SQL credentials, pairing codes or
# connector tokens here. EXPO_PUBLIC_* values are readable by app users.
# Details: ../docs/VERCEL-ENVIRONMENTS.md and ../docs/SHOP-PC-DEV-SETUP.md.
