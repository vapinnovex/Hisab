# Physical phone: use your computer's LAN IP, e.g. http://192.168.1.20:8000
# Android emulator: http://10.0.2.2:8000; iOS simulator/web: http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Branding: set development on the dev deployment and production on prod.
# Independent of NODE_ENV; changing this requires a rebuild/redeploy.
EXPO_PUBLIC_APP_ENV=production

# Browser-only override for local development (ignored by production web builds):
# exported PWAs use same-origin /api through mobile/vercel.mjs.
# EXPO_PUBLIC_WEB_API_URL=http://localhost:8000

# Vercel project configuration (set in the dashboard, not as Expo public variables):
# See ../docs/VERCEL-ENVIRONMENTS.md. Both stable deployments use Vercel's Production scope.
# APP_ENV=development
# API_PROXY_TARGET=https://hishob-dev.onrender.com
# Enable Vercel system variables; do not manually override VERCEL_PROJECT_NAME or VERCEL_GIT_COMMIT_REF.
